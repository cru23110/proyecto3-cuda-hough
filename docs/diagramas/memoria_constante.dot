// dot -Tpng -Gdpi=150 memoria_constante.dot -o memoria_constante.png
digraph G {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.4, ranksep=0.35, label="Kernel con memoria constante (tablas cos/sin)", labelloc=t];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=10, color="#555555"];

  subgraph cluster_host {
    label="Host (CPU), una sola vez antes del kernel"; style="rounded,dashed"; color="#999999";
    build [label="Paso 1: buildTrigTables()\npcCos[t] = cos(t·2°), pcSin[t] = sin(t·2°)\n90 ángulos", fillcolor="#f2f2f2", color="#7f7f7f"];
    copy  [label="Paso 2: cudaMemcpyToSymbol(d_Cos / d_Sin)\nsin cudaMalloc ni cudaFree", fillcolor="#f2f2f2", color="#7f7f7f"];
  }

  subgraph cluster_dev {
    label="Device (GPU)"; style="rounded,dashed"; color="#999999";
    cmem  [label="__constant__ d_Cos[90], d_Sin[90]\nMemoria CONSTANTE: 720 B de 64 KB\nscope global, solo lectura en el kernel", fillcolor="#e2efda", color="#548235"];
    cache [label="Caché de constantes del SM\nlos 720 B quedan en caché tras el primer acceso", fillcolor="#e2efda", color="#548235"];
    warp  [label="Paso 3: Broadcast al warp\nen la iteración tIdx los 32 hilos leen d_Cos[tIdx]\n1 lectura sirve a 32 hilos", fillcolor="#fff2cc", color="#bf9000"];
    pic   [label="pic[w*h]\nMemoria GLOBAL (imagen)", fillcolor="#fde9d9", color="#c0504d"];
    vote  [label="Paso 4: r = x·cos + y·sin → rIdx\natomicAdd(&acc[rIdx*90 + tIdx], 1)\n12.46 M atomics en memoria global", fillcolor="#fff2cc", color="#bf9000"];
    acc   [label="acc[9000]\nMemoria GLOBAL\ncuello de botella: contención atómica", fillcolor="#fde9d9", color="#c0504d"];
  }

  build -> copy -> cmem -> cache -> warp -> vote -> acc;
  pic -> vote [label="lee 1 byte por hilo"];
}
